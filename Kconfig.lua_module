menu "EerieLeap Lua"

config LUA
    bool "Lua support"
    help
      Enable Lua support. This is required for the Lua scripting engine.
      If you enable this option, you will be able to use Lua scripts.

module = EERIE_LEAP_LUA
module-str = eerie_leap_lua
source "subsys/logging/Kconfig.template.log_config"
endmenu
